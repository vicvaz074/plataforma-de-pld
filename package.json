{
  "name": "davara-pld-mexico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/prepare-pdf-worker.mjs",
    "build": "next build",
    "postbuild": "node scripts/prepare-pages-proxy.mjs",
    "dev": "next dev",
    "predev": "node scripts/prepare-pdf-worker.mjs",
    "typecheck": "tsc --noEmit && tsc -p workers/tsconfig.json",
    "dev:pilot": "wrangler dev -c wrangler.worker.jsonc --ip 127.0.0.1 --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply davara-pld-pilot -c wrangler.worker.jsonc --local",
    "build:worker": "wrangler deploy -c wrangler.worker.jsonc --dry-run --outdir .wrangler/dist",
    "lint": "next lint",
    "sync:pep:cargos": "tsx scripts/sync-pep-cargos.mjs",
    "sync:pep:extract-pdf": "tsx scripts/extract-pep-cargos-pdf.mjs",
    "sync:pep:gobernadores": "node scripts/sync-pep-gobernadores-mx.mjs",
    "sync:pep:legislativo": "node scripts/sync-pep-legislativo-mx.mjs",
    "sync:pep:nomina-apf": "node scripts/sync-pep-nomina-apf-mx.mjs",
    "sync:pep:opensanctions": "node scripts/sync-pep-opensanctions.mjs",
    "sync:pep:personas": "tsx scripts/sync-pep-personas-mx.mjs",
    "sync:pep:verify-cargos": "node scripts/verify-pep-cargos-mx.mjs",
    "sync:pep:all": "pnpm sync:pep:cargos && pnpm sync:pep:nomina-apf && pnpm sync:pep:legislativo && pnpm sync:pep:gobernadores && pnpm sync:pep:verify-cargos && pnpm sync:pep:personas && pnpm validate:pep:data",
    "sync:sat:formatos": "tsx scripts/sync-sat-formatos.mjs",
    "sync:sat:postal": "node scripts/sync-sat-postal-catalog.mjs",
    "validate:pep:data": "tsx scripts/validate-pep-data.mjs",
    "check:release-config": "tsx --test tests/pilot-release-config.test.ts",
    "test:pld": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "start": "next start",
    "sync:sat:layouts": "tsx scripts/rebuild-sat-xlsm-layouts.mjs"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "1.4.0",
