    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "miniflare": "4.20260730.0",
    "postcss": "8.5.33",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.160.1"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "$postcss",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "miniflare@4.20260730.0>sharp": "0.35.5",
      "miniflare@4.20260730.0>undici": "7.30.1"
    }
  }
}
