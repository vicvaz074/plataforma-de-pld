    "autoprefixer": "^10.4.20",
    "bcryptjs": "3.0.2",
    "better-auth": "1.7.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "cookie": "1.0.2",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "fflate": "0.8.3",
    "framer-motion": "12.23.22",
    "geist": "^1.3.1",
    "input-otp": "1.4.1",
    "jspdf": "4.2.1",
    "kysely": "0.28.17",
